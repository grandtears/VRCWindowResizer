<Window x:Class="VRChatWindowSizer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VRChat Window Sizer" Width="510" Height="760" MinWidth="480" MinHeight="700" Background="#F4FBFE" Foreground="#17384A" FontFamily="Yu Gothic UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#D7F1FA"/>
      <Setter Property="Foreground" Value="#0E5C84"/>
      <Setter Property="BorderBrush" Value="#8FCBE4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#C3E7F6"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#A8D8EF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#17384A"/>
      <Setter Property="BorderBrush" Value="#9FCFE6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="CaretBrush" Value="#17384A"/>
    </Style>
  </Window.Resources>
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- 見出しです。操作そのものは下の各段で行います。 -->
    <StackPanel><TextBlock Text="VRChat Window Sizer" FontSize="26" FontWeight="SemiBold" Foreground="#0E6F9A"/><TextBlock Text="ゲーム画面のサイズを、ワンクリックで。" Foreground="#5E8498" Margin="0,6,0,22"/></StackPanel>
    <!-- 検出中のクライアント領域です。枠やタイトルバーの太さは含めません。 -->
    <Border Grid.Row="1" Background="#E7F6FC" BorderBrush="#C5E6F4" BorderThickness="1" Padding="16" CornerRadius="8" Margin="0,0,0,22"><StackPanel><TextBlock Text="現在のウィンドウ" Foreground="#5E8498"/><TextBlock x:Name="CurrentText" Text="検出中…" FontSize="20" Margin="0,6,0,0"/></StackPanel></Border>
    <!-- 「初期」だけは検出サイズで、残りは presets.txt から作ります。横スクロールはさせず、多いときは縦に送れるようにします。 -->
    <StackPanel Grid.Row="2"><DockPanel Margin="0,0,0,10"><Button x:Name="EditPresetsButton" Content="一覧を編集" Click="OpenPresetFile" Padding="10,4" Margin="0" DockPanel.Dock="Right"/><TextBlock Text="プリセット" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#0E6F9A"/></DockPanel><ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="PresetPanel"><Button x:Name="InitialPresetButton" Content="初期サイズ" Click="PresetClick" IsEnabled="False" ToolTip="最初に検出したゲーム画面のサイズ"/></WrapPanel></ScrollViewer></StackPanel>
    <!-- 1280 と 720 は未入力の印です。初期サイズが決まると、この組み合わせのときだけ置き換えます。 -->
    <StackPanel Grid.Row="3" Margin="0,14,0,18"><TextBlock Text="カスタムサイズ（ピクセル）" Margin="0,0,0,10" Foreground="#0E6F9A"/><StackPanel Orientation="Horizontal"><TextBox x:Name="WidthInput" Text="1280" Width="100"/><TextBlock Text=" × " VerticalAlignment="Center"/><TextBox x:Name="HeightInput" Text="720" Width="100"/><Button Content="適用" Click="CustomClick" Margin="12,0,0,0" Background="#B9E4F5"/></StackPanel></StackPanel>
    <!-- サイズだけでなく、画面上の位置も戻します。初期サイズのボタンとは別の保存です。 -->
    <Border Grid.Row="4" Background="White" BorderBrush="#C5E6F4" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel><TextBlock Text="保存したサイズ" Foreground="#5E8498"/><TextBlock x:Name="SavedText" Margin="0,6,0,12"/><WrapPanel><Button Content="保存した状態に戻す" Click="RestoreClick"/><Button Content="現在の状態を保存" Click="SaveClick"/></WrapPanel></StackPanel></Border>
    <!-- 操作の結果と、使い方の短い説明です。 -->
    <StackPanel Grid.Row="5" VerticalAlignment="Bottom" Margin="0,18,0,0"><TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#176F96"/><TextBlock Text="VRChatをウィンドウモードで起動してください。最初に検出したサイズは「初期」プリセットとして残します。その他のサイズは presets.txt に追記すると反映されます。" TextWrapping="Wrap" FontSize="12" Foreground="#5E8498" Margin="0,10,0,0"/></StackPanel>
  </Grid>
</Window>
